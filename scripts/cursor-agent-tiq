#!/usr/bin/env bash
set -euo pipefail

# Cursor Agent wrapper that ingests ONLY safe stream-json records into TelemetryIQ.
#
# It runs cursor-agent in stream-json mode and pipes the output through the
# ingest helper which extracts only:
# - system/init
# - result
#
# It intentionally ignores user/assistant message records so prompt/response
# content is not sent to TelemetryIQ by default.

DAEMON_URL="${TELEMETRYIQ_DAEMON:-http://localhost:8080}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec cursor-agent agent --print --output-format stream-json --mode ask --trust "$@" \
  | python3 "${SCRIPT_DIR}/ingest-cursor-agent-stream-json.py" --daemon "${DAEMON_URL}"

